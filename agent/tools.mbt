pub(all) struct Tool {
  name : String
  description : String
  fields : Array[String]
} derive(ToJson)
pub extend Tool with ToJson::{to_json}

pub fn tools() -> Array[Tool] {
  [
    { name: "session-open", description: "绑定进程级 vault 会话并持有其写锁", fields: ["vault"] },
    { name: "session-close", description: "关闭当前 vault 会话并释放写锁", fields: [] },
    { name: "init", description: "初始化空 vault", fields: ["purpose"] },
    { name: "status", description: "登记版本、页面、来源和工单状态；全量核验请调用 verify", fields: [] },
    { name: "scan", description: "登记 raw 变更，创建分析工单并传播来源失效", fields: [] },
    { name: "refresh", description: "重检并登记人类外部页面修改及来源变更；成功后重建缓存", fields: [] },
    { name: "plan", description: "列出可继续执行的持久化工单", fields: [] },
    { name: "context", description: "读取工单、来源和既有页面全文/哈希", fields: ["order"] },
    { name: "analysis-submit", description: "提交结构化分析，进入页面生成阶段；可用上下文 token 拒绝迟到结果", fields: ["order", "analysis", "context_token"] },
    { name: "draft-submit", description: "验证结构化页面并写入内容寻址 staging；不发布知识", fields: ["order", "context_token", "pages"] },
    { name: "commit", description: "校验 staging 草稿并编译发布索引", fields: ["order", "pages", "at", "context_token"] },
    { name: "cancel", description: "取消未提交工单", fields: ["order"] },
    { name: "recover", description: "恢复未完成文件事务", fields: [] },
    { name: "list-pages", description: "列出目录中的知识页及失效状态", fields: [] },
    { name: "read-page", description: "读取页面正文与来源，显式报告失效", fields: ["id"] },
    { name: "page-history", description: "按时间列出某页的发布、归档、恢复和来源撤销历史及各版本 SHA-256，供查阅、核对与修正", fields: ["id"] },
    { name: "archive-page", description: "归档页面并传播依赖失效；保留正文和审计事件", fields: ["id", "at", "reason"] },
    { name: "restore-page", description: "恢复已归档页面；重新校验正文、来源和互链", fields: ["id", "at"] },
    { name: "read-index", description: "读取文学化索引源码", fields: [] },
    { name: "read-last-valid", description: "显式读取上次有效目录快照，仍核验所有内容版本", fields: [] },
    { name: "read-purpose", description: "读取知识意图", fields: [] },
    { name: "read-source", description: "按 id 读取已登记 raw 来源：登记格式、SHA-256 是否仍匹配、失效状态与文本内容；可用 start/end 取 UTF-8 字节半开区间以核对 evidence 锚点；binary/image 只报告体积并要求外部抽取", fields: ["id", "start", "end"] },
    { name: "search", description: "关键词/暴力向量检索、外部候选后端、图扩展、查询定位与去重预算装配；dedup 可选 exact/similar 近似段落合并，spread 可选 ranked/even 预算分配；返回正文 UTF-8 区间和重复页引用", fields: ["query", "limit", "query_vector", "vector_candidates", "provider", "budget", "hops", "dedup", "spread"] },
    { name: "topics", description: "按主题浏览 synthesis 页：标题、wikilink 目标、raw 来源与失效状态，便于先看主题再定位材料并回原文核对", fields: [] },
    { name: "tree", description: "页面路径树数据", fields: [] },
    { name: "graph", description: "有向互链和共享来源图", fields: ["seed", "hops"] },
    { name: "neighbors", description: "页面双向邻居", fields: ["id"] },
    { name: "path", description: "页面间最短无向路径", fields: ["from", "to"] },
    { name: "weighted-path", description: "按互链/共同来源权重计算的最短无向路径", fields: ["from", "to"] },
    { name: "insights", description: "孤儿页、跨类型桥接、稀疏标签、连通分量和确定性加权社区", fields: [] },
    { name: "quality-audit", description: "把已验证图中的孤儿页、稀疏标签、未进入知识图的来源、legacy/invalid 证据锚点、证据覆盖缺口和缺少有效事实证据的页面记录为可恢复的 HumanGate 审核债务", fields: ["at"] },
    { name: "research-topic", description: "持久化研究主题与查询工单；外部宿主负责联网并将结果写入 raw/ 后重新 scan", fields: ["topic", "queries", "at", "key"] },
    { name: "research-list", description: "列出研究主题工单及其状态，供外部宿主恢复执行", fields: [] },
    { name: "research-complete", description: "用已登记且有效的 raw 来源关闭研究主题工单", fields: ["id", "sources", "at"] },
    { name: "research-cancel", description: "取消尚未完成的研究主题工单", fields: ["id", "at"] },
    { name: "purpose-suggest", description: "创建带当前目标/知识图上下文的目标建议工单；建议文本由外部宿主生成", fields: ["at", "key"] },
    { name: "purpose-apply", description: "在人类确认后按目标基线原子更新 purpose.md", fields: ["id", "text", "at"] },
    { name: "suggestion-list", description: "列出目标建议工单及其状态", fields: [] },
    { name: "purpose-cancel", description: "取消尚未应用的目标建议工单；记录与冻结上下文保留用于审计", fields: ["id", "at"] },
    { name: "overview-suggest", description: "冻结综述所需的目标、页面和图上下文，交给外部宿主生成 synthesis 页面", fields: ["at", "key"] },
    { name: "overview-apply", description: "按综述基线原子发布 wiki/overview.md", fields: ["id", "text", "at"] },
    { name: "overview-list", description: "列出综述生成建议及状态", fields: [] },
    { name: "overview-cancel", description: "取消尚未应用的综述建议工单；记录与冻结上下文保留用于审计", fields: ["id", "at"] },
    { name: "evidence-submit", description: "提交绑定页面版本、raw 来源和 UTF-8 正文区间的事实证据", fields: ["page", "page_hash", "items"] },    { name: "evidence-replace", description: "用 exact raw 锚点原子替换旧证据记录并保留 superseded 审计历史", fields: ["page", "page_hash", "previous", "items"] },
    { name: "evidence-list", description: "列出页面证据记录及其当前有效性", fields: ["page"] },
    { name: "memory-submit", description: "记录终身记忆笔记（偏好/决定/约束/事实/目标）及其适用条件与 raw 来源；同 key 同内容幂等重放，同 key 新内容自动 supersede", fields: ["kind", "scope", "text", "conditions", "sources", "at", "key"] },
    { name: "memory-supersede", description: "用新正文、条件或来源替换指定记忆笔记，旧记录标记 superseded 并保留审计历史", fields: ["id", "text", "conditions", "sources", "at", "key"] },
    { name: "memory-archive", description: "归档记忆笔记，移出默认检索与预取范围；仍可列出和恢复", fields: ["id", "at"] },
    { name: "memory-restore", description: "恢复已归档记忆笔记为 active", fields: ["id", "at"] },
    { name: "memory-list", description: "列出记忆笔记、适用条件、supersede 链和来源失效状态", fields: [] },
    { name: "memory-read", description: "按 id 读取单条记忆笔记及其适用条件、冲突与来源失效状态", fields: ["id"] },
    { name: "memory-pin", description: "设置或清除记忆笔记的 pinned 标记；pinned 笔记拒绝 memory-archive，避免自动整理丢掉重要判断", fields: ["id", "pinned", "at"] },
    { name: "memory-use", description: "登记本次前台用到过的记忆笔记，写入 last_used_at；供宿主判断哪些笔记长期未用而可归档。prefetch 本身只读，不自动记录使用", fields: ["ids", "at"] },
    { name: "memory-prefetch", description: "按 query 或按 page（以该页 title+body 作确定性种子）对 active 记忆笔记做 BM25 候选排序，连同 purpose、综述和同条件冲突候选返回有界 brief；dedup 可选 none/similar 合并改写变体，kinds 可按类型过滤；筛选由外部宿主决定", fields: ["query", "page", "limit", "archived", "dedup", "kinds"] },
    { name: "memory-candidates", description: "无需种子地列出记忆整合候选：可合并的近重复组与从未使用的精简候选；只报信号不做决定，冲突、pinned、已替代/已归档、来源失效或漂移的笔记均不提名", fields: [] },
    { name: "memory-conflicts", description: "列出 kind 与适用条件相同但正文不一致的 active 记忆笔记冲突候选；两侧都保留，由 memory-supersede 解决", fields: [] },
    { name: "impact-audit", description: "比较持久化工单冻结的输入与当前 vault，把研究主题/目标建议/综述建议/已发布综述的漂移记录为可恢复的 impact；漂移消失则关闭记录", fields: ["at", "key"] },
    { name: "impact-list", description: "列出 change-impact 记录、冻结与当前输入摘要及 open/resolved 状态", fields: [] },
    { name: "impact-resolve", description: "记录宿主已处理某条 change-impact 的决定并关闭它；执行仍交宿主", fields: ["id", "note", "at"] },
    { name: "inbox", description: "汇总所有待宿主处理的工作：change-impact、审核债务、研究/目标/综述工单、失效页面和未登记来源；空 inbox 表示无需主动介入", fields: [] },
    { name: "view-init", description: "创建默认文学化阅读页面，拒绝覆盖", fields: ["view"] },
    { name: "render-view", description: "编译文学化页面并输出离线阅读快照", fields: ["view"] },
    { name: "stats", description: "知识/图/审核/证据覆盖统计；coverage 只衡量有效 UTF-8 区间，不判断语义蕴含", fields: [] },
    { name: "fingerprints", description: "权威数据与索引输入指纹", fields: [] },
    { name: "read-log", description: "按稳定事件 id 读取持久化事件；可选 limit 返回最后 N 条", fields: ["limit"] },
    { name: "review-list", description: "读取审核项与人工决定，并标记输入快照 current/stale/unknown", fields: [] },
    { name: "review-resolve", description: "记录幂等人工决定并追加审核事件，执行由宿主继续", fields: ["id", "action", "note", "at", "key"] },
    { name: "backfill", description: "将显式查询结果归档为 raw 来源并进入工单", fields: ["title", "text"] },
    { name: "pack", description: "确定性 ZIP 快照，输出至 exports/*.mcpack，拒绝覆盖", fields: ["output"] },
    { name: "import", description: "导入 imports/* 下的 OKF/Markdown bundle，保留原件并原子发布知识目录", fields: ["format", "directory", "at"] },
    { name: "export", description: "导出至 exports/*；可指定 bundle 保留未知元数据并往返原件", fields: ["format", "directory", "bundle"] },
    { name: "unpack", description: "完整校验并恢复 imports/*.mcpack 至空 vault", fields: ["file"] },
    { name: "embedding-submit", description: "提交已生成向量；验证空间、维度与页面版本", fields: ["space", "items", "provider"] },
    { name: "embedding-plan", description: "按空间与正文版本列出缺失向量的活跃页面；返回有界文本批次", fields: ["space", "limit", "provider"] },
    { name: "provider-register", description: "注册外部 embedding/search provider 的能力、协议和向量空间", fields: ["provider", "kind", "space", "capabilities", "at"] },
    { name: "provider-heartbeat", description: "更新外部 provider 的租约心跳", fields: ["provider", "at"] },
    { name: "provider-unregister", description: "撤销外部 provider，保留审计记录", fields: ["provider", "at"] },
    { name: "provider-list", description: "列出已注册 provider 的状态和向量空间", fields: [] },
    { name: "provider-job-open", description: "创建可恢复的外部 provider 执行任务；引擎只记录请求，不启动进程", fields: ["provider", "kind", "space", "request", "at", "key"] },
    { name: "provider-job-claim", description: "以 worker 领取 pending provider 任务并写入可验证租约", fields: ["id", "worker", "lease_until", "at"] },
    { name: "provider-job-heartbeat", description: "由当前 worker 续租 provider 任务；过期或越权续租会被拒绝", fields: ["id", "worker", "lease_until", "at"] },
    { name: "provider-job-complete", description: "提交外部 provider 任务结果并关闭任务；若任务已领取必须携带相同 worker 且租约仍有效", fields: ["id", "result", "at", "worker"] },
    { name: "provider-job-cancel", description: "取消尚未完成的外部 provider 任务；若任务已领取必须携带相同 worker 且租约仍有效", fields: ["id", "at", "worker"] },
    { name: "provider-job-fail", description: "记录外部 provider 任务超时、进程错误或协议失败，不写入结果；允许领取者在租约过期后报告超时", fields: ["id", "error", "at", "worker"] },
    { name: "provider-job-list", description: "列出可恢复的 provider 任务及其状态", fields: [] },
    { name: "forget", description: "撤销一个来源，相关页面失效", fields: ["source", "at"] },
    { name: "rebuild", description: "验证权威数据后重建检索缓存", fields: [] },
    { name: "verify", description: "校验声明、文件、来源和索引缓存", fields: [] },
    { name: "lint", description: "只读收集目录、来源、正文、页面链接、状态记录和检索缓存问题；返回稳定 predicate/subject/path/detail/fix 诊断", fields: [] },
    { name: "check-index", description: "实际编译文学化目录并校验引用文件", fields: [] },
    { name: "list-tools", description: "工具字典与参数", fields: [] },
    { name: "help", description: "工具字典", fields: [] },
  ]
}

pub fn tool(name : String) -> Tool raise @base.Fault {
  for t in tools() { if t.name == name { return t } }
  raise @base.Fault("unknown_operation: " + name + "; use list-tools")
}
